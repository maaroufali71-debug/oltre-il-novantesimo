---
layout: layouts/base.njk
title: Contattaci
permalink: contatti/index.html
---

<section class="contact-section">
  <h1>Contatta la redazione</h1>
  <p>
    Hai una domanda, una proposta o vuoi collaborare con
    Oltre il Novantesimo? Scrivici!
  </p>

  <form name="contatti" method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field">

    <input type="hidden" name="form-name" value="contatti">

    <p hidden>
      <label>Non compilare: <input name="bot-field"></label>
    </p>

    <label for="nome">Nome</label>
    <input id="nome" type="text" name="nome" required>

    <label for="email">La tua email</label>
    <input id="email" type="email" name="email" required>

    <label for="oggetto">Oggetto</label>
    <input id="oggetto" type="text" name="oggetto" required>

    <label for="messaggio">Messaggio</label>
    <textarea id="messaggio" name="messaggio" rows="6" required></textarea>

    <button type="submit">Invia messaggio</button>
  </form>
</section>
