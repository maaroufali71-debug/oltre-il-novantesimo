---
layout: layouts/base.njk
title: Tutti gli articoli
pagination:
  data: collections.articles
  size: 6
  alias: articles
  reverse: true
  generatePageOnEmptyData: false
permalink: "{% if pagination.pageNumber == 0 %}/articoli/index.html{% else %}/articoli/pagina/{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
---

<section class="section">
  <div class="section-heading">
    <div>
      <span class="eyebrow">ARCHIVIO</span>
      <h1>Tutti gli articoli</h1>
    </div>
    <span class="section-note">Le storie oltre il risultato</span>
  </div>

  {% if articles.length %}
  <div class="article-grid">
    {% for article in articles %}
    <article class="article-card">
      <a class="article-image" href="{{ article.url }}">
        {% if article.data.cover %}
          <img src="{{ article.data.cover }}" alt="">
        {% else %}
          <div class="image-placeholder">
            <span>OLTRE IL<br>NOVANTESIMO</span>
            <b>90′</b>
          </div>
        {% endif %}
      </a>

      <div class="article-content">
        <div class="meta">
          {{ article.data.category or "CALCIO" }} · {{ article.date | dateIT }}
        </div>
        <h2>
          <a href="{{ article.url }}">{{ article.data.title }}</a>
        </h2>

        {% if article.data.description %}
          <p>{{ article.data.description }}</p>
        {% endif %}

        <a class="text-link" href="{{ article.url }}">Leggi l'articolo ↗</a>
      </div>
    </article>
    {% endfor %}
  </div>

  <nav class="pagination" aria-label="Paginazione articoli">
    {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}">← Precedente</a>
    {% endif %}

    <div class="pagination-pages">
      {% for href in pagination.hrefs %}
        {% if loop.index0 == pagination.pageNumber %}
          <span class="current" aria-current="page">{{ loop.index }}</span>
        {% else %}
          <a href="{{ href }}">{{ loop.index }}</a>
        {% endif %}
      {% endfor %}
    </div>

    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}">Successiva →</a>
    {% endif %}
  </nav>

  {% else %}
  <div class="empty-state">
    <h2>Non ci sono ancora articoli.</h2>
    <p>Gli articoli pubblicati dalla redazione appariranno qui.</p>
  </div>
  {% endif %}
</section>
